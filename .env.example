# Senha usada para entrar em /admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Segredo longo e aleatório usado para assinar o cookie HttpOnly
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Fine-grained token com permissão Contents: Read and write somente neste repositório
GITHUB_CMS_TOKEN=
GITHUB_REPO_OWNER=leoelevamktt
GITHUB_REPO_NAME=barbara

# Opcional. Na Vercel, o domínio é descoberto automaticamente.
NEXT_PUBLIC_SITE_URL=

# Token de acesso ao repositório privado leoelevamktt/barbara-leads (permissão Issues)
# Configure exclusivamente no ambiente de produção da Vercel; não envie para o navegador.
GITHUB_LEADS_TOKEN=
